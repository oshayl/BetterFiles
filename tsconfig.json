{
  "compilerOptions": {
    "target": "ES2020",
    // "DOM" is included because UXP exposes a DOM *subset*. TypeScript cannot
    // model that subset, so it will happily accept APIs UXP lacks (canvas,
    // fetch, IntersectionObserver...). Treat docs/UXP-CONSTRAINTS.md as the
    // real contract - the compiler will not catch these for you.
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true,
    "types": ["vitest/globals"],

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
